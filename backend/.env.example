# ========================================
# GTS DASHBOARD - BACKEND CONFIGURATION
# Portfolio Demo Version
# ========================================

# ----------------
# DATABASE
# ----------------
# MongoDB Connection String (Create a new free cluster for demo)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gts-demo?retryWrites=true&w=majority

# ----------------
# SERVER
# ----------------
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# Demo Mode (MUST be true for portfolio version to use mock APIs)
DEMO_MODE=true

# Rate Limiting (false in production for security)
DISABLE_RATE_LIMIT=false

# ----------------
# JWT AUTHENTICATION
# ----------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# ----------------
# WEB PUSH NOTIFICATIONS
# ----------------
# Generate new VAPID keys with:
# node -e "const webpush = require('web-push'); const k = webpush.generateVAPIDKeys(); console.log('Public:', k.publicKey, '\nPrivate:', k.privateKey);"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:your-email@example.com

# ----------------
# EMAIL NOTIFICATIONS (OPTIONAL)
# ----------------
# Email service for notifications (disabled in demo mode)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# ----------------
# APP CONFIGURATION
# ----------------
APP_URL=http://localhost:5173
NOTIFICATION_DAYS_BEFORE=10
NOTIFICATION_CHECK_HOUR=9

# ================================================================================
# EXTERNAL API INTEGRATIONS (NOT USED IN DEMO MODE)
# These are mocked when DEMO_MODE=true
# ================================================================================

# ----------------
# TAMM/ABSHER API (Saudi MOI - Vehicle Registration)
# ----------------
# Production API URL
TAMM_API_URL=https://tamm.api.elm.sa
# OAuth2 Authentication
TAMM_AUTH_URL=https://idp.elm.sa/auth/realms/Tamm/protocol/openid-connect/token
TAMM_REALM_NAME=Tamm
# Client Credentials (Get from TAMM Developer Portal)
TAMM_CLIENT_ID=your-client-id
TAMM_CLIENT_SECRET=your-client-secret
TAMM_SUBSCRIPTION_KEY=your-subscription-key
# User Credentials
TAMM_USER_ID_NUMBER=your-national-id
TAMM_CUSTOMER_ID=your-customer-id

# ----------------
# GOSI API (Saudi Social Insurance)
# ----------------
# API Base URL
GOSI_BASE_URL=https://api.gosi.gov.sa
# API Credentials (Request from hrms_support@gosi.gov.sa)
GOSI_API_KEY=your-gosi-api-key
GOSI_CLIENT_ID=your-gosi-client-id
GOSI_CLIENT_SECRET=your-gosi-client-secret
# Company Registration
GOSI_REGISTRATION_NUMBER=your-registration-number
# DPoP Private Key (RSA key for token authentication)
GOSI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----"

# ================================================================================
# SETUP INSTRUCTIONS
# ================================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate JWT_SECRET and VAPID keys (see commands above)
# 3. Create a MongoDB Atlas cluster (free tier) and add connection string
# 4. Set DEMO_MODE=true for portfolio version
# 5. For production use, obtain TAMM and GOSI API credentials
# 6. Update ALLOWED_ORIGINS with your deployed frontend URL
# ================================================================================
