# ========================================
# GTS DASHBOARD - FRONTEND CONFIGURATION
# Portfolio Demo Version
# ========================================

# ----------------
# API CONFIGURATION
# ----------------
# Backend API URL (update for production deployment)
VITE_API_URL=http://localhost:5000/api

# For production deployment on Vercel:
# VITE_API_URL=https://your-backend.onrender.com/api

# ----------------
# APP METADATA
# ----------------
VITE_APP_NAME=GTS Dashboard
VITE_APP_VERSION=1.0.0

# ----------------
# WEB PUSH NOTIFICATIONS
# ----------------
# MUST match backend VAPID_PUBLIC_KEY exactly
# Generate with: node -e "const webpush = require('web-push'); console.log(webpush.generateVAPIDKeys().publicKey);"
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ----------------
# FEATURE FLAGS
# ----------------
# Enable API calls (set to false to use mock data only)
VITE_USE_API=true

# ================================================================================
# SETUP INSTRUCTIONS
# ================================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update VITE_API_URL to match your backend URL
# 3. Copy VAPID_PUBLIC_KEY from backend/.env
# 4. For local development, use http://localhost:5000/api
# 5. For production, use your deployed backend URL (e.g., Render, Railway)
# ================================================================================
